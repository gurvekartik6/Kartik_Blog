# ─── MongoDB ─────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers → Node.js
# Free tier: M0 cluster (512 MB)
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/kyg_blog?retryWrites=true&w=majority

# ─── Server ──────────────────────────────────────────────────
PORT=3000

# ─── Admin API Secret ────────────────────────────────────────
# Used to protect POST/PATCH/DELETE post routes
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET

# ─── Frontend URL (CORS) ─────────────────────────────────────
# Set to your deployed frontend URL in production
# e.g. https://kartikyadavgurve.vercel.app
# Use * for development
FRONTEND_URL=*
